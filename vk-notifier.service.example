[Unit]
Description=VK to iOS Push Notifier (Bark)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Replace /root/vk-ios-notifier with the actual directory where this repo is cloned
WorkingDirectory=/root/vk-ios-notifier
Environment=PYTHONUNBUFFERED=1
# Основной стабильный браузерный режим (Chromium DOM, нативный фингерпринт):
ExecStart=/usr/bin/python3 /root/vk-ios-notifier/src/web_notifier.py
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=300
StartLimitBurst=2
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
