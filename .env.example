# Personal Device Key from Bark app on iOS (get it from the Bark app home screen)
BARK_KEY=your_bark_device_key_here

# Optional: Custom Bark server URL (defaults to https://api.day.app if omitted or empty)
# BARK_SERVER=https://api.day.app

# Optional: HTTP/SOCKS5 proxy for VK traffic (recommended Russian IPv4/residential proxy)
# VK_PROXY=http://username:password@ip:port

# Optional: Night sleep mode to emulate human behavior (closes browser at night)
# SLEEP_MODE_ENABLED=True
# SLEEP_START=02:00
# SLEEP_END=07:30
# SLEEP_JITTER_MIN=20
# SLEEP_TIMEZONE=Europe/Moscow

# Optional: Day break mode (closes browser for 15 min between 17:00 and 19:00 MSK)
# DAY_BREAK_ENABLED=True
# DAY_BREAK_START_HOUR=17
# DAY_BREAK_END_HOUR=19
# DAY_BREAK_DURATION_SEC=900

# Optional: Periodic soft session rotation (in seconds, default 8 hours = 28800)
# SESSION_MAX_LIFETIME_SEC=28800
